{
    "version": "2.0.0",
    "tasks": [
        {
            // The shader was not part of the build at all -- shaders/compute.spv
            // had to be regenerated by hand, which is an easy way to benchmark
            // or ship a stale one.
            "label": "Build-Shader",
            "type": "shell",
            "command": "${env:VULKAN_SDK}/Bin/glslangValidator.exe",
            "args": [
                "-V",
                "--target-env", "vulkan1.2",
                "${workspaceFolder}/shaders/compute.comp",
                "-o", "${workspaceFolder}/shaders/compute.spv"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build-Vulkan",
            "type": "shell",
            "command": "g++",
            "args": [
                // -O2, not -g: the host builds every game, folds every result
                // and drives the dispatch loop, and at -O0 that work shows up
                // next to the GPU's.
                "-O2",
                "-std=c++20",
                "-Wall",
                "-Wextra",
                "-I${env:VULKAN_SDK}/Include",
                "${workspaceFolder}/src/main.cpp",
                "-o",
                "${workspaceFolder}/engine.exe",
                "-L${workspaceFolder}/lib",
                "-lvulkan"
            ],
            "dependsOn": [
                "Build-Shader"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
